# Get list of staged markdown files
staged_md_files=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)

if [ -n "$staged_md_files" ]; then
  echo "Formatting staged markdown files to 80 characters..."
  # We use --prose-wrap always to ensure lines are wrapped at the print-width
  npx prettier --prose-wrap always --print-width 80 --write $staged_md_files
  git add $staged_md_files
fi

# Get list of staged JavaScript/TypeScript files
staged_js_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts)$' || true)

if [ -n "$staged_js_files" ]; then
  echo "Formatting staged JS/TS files..."
  npx prettier --write $staged_js_files
  git add $staged_js_files

  # Only run eslint on JS/TS files that match config patterns
  staged_lintable_files=$(echo "$staged_js_files" | grep -E '\.(js|ts)$' || true)
  if [ -n "$staged_lintable_files" ]; then
    echo "Linting staged files with ESLint..."
    npx eslint --no-error-on-unmatched-pattern $staged_lintable_files
  fi
fi

# Run Cantonese chapter format validator if curriculum or any chapter file is staged
staged_chapters_or_curriculum=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^content/.*\.md$' | grep -vE '^content/README\.md$|^content/vocabulary\.md$' || true)

if [ -n "$staged_chapters_or_curriculum" ]; then
  echo "Validating Cantonese course content formatting and curriculum alignment..."
  npx tsx scripts/validate-format.ts

  echo "Updating vocabulary database and glossary..."
  npx tsx scripts/track-vocabulary.ts
  git add content/vocabulary.json content/vocabulary.md
fi

echo "Typechecking codebase..."
npm run typecheck

echo "Verifying project portability (no hardcoded absolute paths)..."
npx tsx scripts/validate-portability.ts

echo "Running unit tests with coverage verification..."
npx vitest run --coverage
