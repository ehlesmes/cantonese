---
import fs from "fs";
import path from "path";

import BaseLayout from "../../layouts/BaseLayout.astro";
import CantoneseExample from "../../components/CantoneseExample.astro";
import DialogueBlock from "../../components/DialogueBlock.astro";
import { processChapterBlocks, calculateNavigation } from "../../utils/chapter-utils.js";

export async function getStaticPaths() {
  const { parseCurriculum, buildCurriculumIndex } = await import("../../../scripts/lib/parser");
  const { buildChapterPaths } = await import("../../utils/chapter-utils.js");
  const curriculumPath = path.resolve("content/curriculum.md");
  const curriculumContent = fs.readFileSync(curriculumPath, "utf8");
  const chapters = parseCurriculum(curriculumContent);

  const contentDir = path.resolve("content");
  const chapterContents: Record<string, string | null> = {};
  for (const chapter of chapters) {
    const filePath = path.join(contentDir, chapter.file);
    try {
      chapterContents[chapter.file] = fs.readFileSync(filePath, "utf8");
    } catch {
      chapterContents[chapter.file] = null;
    }
  }

  const entries = buildCurriculumIndex(chapters, chapterContents);
  return buildChapterPaths(entries, contentDir, path.join);
}

const { id } = Astro.params;
const { filePath, chapterNumber, allChapters } = Astro.props;

// Load Chapter data
const { parseChapter, parseYAML } = await import("../../../scripts/lib/parser");
const chapterContent = fs.readFileSync(filePath, "utf8");
const { frontmatter, blocks } = parseChapter(chapterContent);

// Pre-process all blocks
const processedBlocks = await processChapterBlocks(blocks, parseYAML);

// Find navigation links
const { prevChapter, nextChapter } = calculateNavigation(allChapters, id);
---

<BaseLayout title={frontmatter!.title} description={frontmatter!.description}>
  <div style="margin-bottom: 2rem;">
    <span style="font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-color);">
      Chapter {chapterNumber}
    </span>
    <h1 style="margin-top: 0.2rem; margin-bottom: 0.5rem;">{frontmatter!.title}</h1>
    <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.4; font-style: italic; margin-bottom: 0;">
      {frontmatter!.description}
    </p>
  </div>

  <article>
    {processedBlocks.map((block) => 
      block.type === "prose" ? (
        <div class="prose-block chapter-block" set:html={block.html} />
      ) : block.type === "cantonese" ? (
        <CantoneseExample content={block.content} />
      ) : block.type === "dialog" ? (
        <DialogueBlock content={block.content} />
      ) : block.type === "exercise" ? (
        <div class="cantonese-example-card chapter-block" style="border-left-color: var(--secondary-color); background-color: #f7f5ef; padding: 0.8rem 1rem;">
          <div style="font-family: var(--font-heading); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; color: var(--secondary-color); margin-bottom: 0.4rem; letter-spacing: 0.05em;">
            Practice Exercise
          </div>
          <div class="prose-block" style="margin-bottom: 0.6rem;" set:html={block.questionHtml} />
          
          <div style="border-top: 1px dashed var(--border-color); padding-top: 0.5rem; margin-top: 0.5rem;">
            <details style="cursor: pointer;">
              <summary style="font-size: 0.9rem; font-weight: 600; color: var(--accent-color); outline: none;">
                Reveal Answer & Explanation
              </summary>
              <div style="margin-top: 0.4rem; padding-left: 0.5rem; border-left: 2px solid var(--border-color); cursor: default;">
                <div style="font-weight: 600; margin-bottom: 0.2rem;">Answer: <span set:html={block.answerHtml} style="font-weight: normal; display: inline;" /></div>
                <div class="prose-block" style="font-size: 0.9rem; color: var(--text-muted);" set:html={block.explanationHtml} />
              </div>
            </details>
          </div>
        </div>
      ) : null
    )}
  </article>

  {/* Review Pool Toggle Card */}
  <div class="cantonese-example-card chapter-block" style="margin-top: 2.5rem; background-color: var(--card-bg); border-left-color: var(--secondary-color); padding: 1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 250px;">
      <h3 style="margin: 0 0 0.2rem 0; font-size: 1.05rem; font-family: var(--font-heading); color: var(--text-color);">Practice this Chapter</h3>
      <p style="margin: 0; font-size: 0.88rem; color: var(--text-muted); line-height: 1.4;">
        Add the vocabulary, examples, and dialogues of this chapter to your Spaced Repetition (SRS) Phrasebook and Vocabulary pools.
      </p>
    </div>
    <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--secondary-color); cursor: pointer; user-select: none;">
      <input type="checkbox" id="review-pool-checkbox" data-chapter={id} style="width: 1.15rem; height: 1.15rem; accent-color: var(--secondary-color); cursor: pointer;" />
      Mark as completed
    </label>
  </div>

  <script>
    import { getUnlockedChapters, saveUnlockedChapters } from "../../client/sys/storage";

    document.addEventListener('DOMContentLoaded', () => {
      const checkbox = document.getElementById('review-pool-checkbox') as HTMLInputElement;
      if (!checkbox) return;
      
      const chapterId = checkbox.getAttribute('data-chapter');
      if (!chapterId) return;
      
      // Set initial checkbox state
      const unlocked = getUnlockedChapters();
      checkbox.checked = unlocked.includes(chapterId);
      
      // Listen for changes
      checkbox.addEventListener('change', () => {
        try {
          const currentUnlocked = getUnlockedChapters();
          
          let updatedUnlocked;
          if (checkbox.checked) {
            updatedUnlocked = currentUnlocked.includes(chapterId) 
              ? currentUnlocked 
              : [...currentUnlocked, chapterId];
          } else {
            updatedUnlocked = currentUnlocked.filter(slug => slug !== chapterId);
          }
          
          saveUnlockedChapters(updatedUnlocked);
        } catch (e) {
          console.error('Failed to update review pool:', e);
        }
      });
    });
  </script>

  {/* Pagination Navigation */}
  <nav style="display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; padding-top: 1rem; border-top: 2px solid var(--border-color);">
    <div>
      {prevChapter && (
        <a href={`/cantonese/chapter/${prevChapter.id}/`} style="font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--accent-color); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--accent-hover)'" onmouseout="this.style.color='var(--accent-color)'">
          &larr; Chapter {prevChapter.chapter}: {prevChapter.title}
        </a>
      )}
    </div>
    <div>
      <a href="/cantonese/" style="font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--accent-color); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--accent-hover)'" onmouseout="this.style.color='var(--accent-color)'">
        Home
      </a>
    </div>
    <div>
      {nextChapter && (
        <a href={`/cantonese/chapter/${nextChapter.id}/`} style="font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--accent-color); text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='var(--accent-hover)'" onmouseout="this.style.color='var(--accent-color)'">
          Chapter {nextChapter.chapter}: {nextChapter.title} &rarr;
        </a>
      )}
    </div>
  </nav>
</BaseLayout>
