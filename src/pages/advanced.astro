---
import fs from "fs";
import fsPromises from "fs/promises";
import path from "path";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/advanced-settings.css";
import { parseCurriculum, parseChapter } from "../../scripts/lib/parser";
const curriculumPath = path.resolve("content/curriculum.md");
const chapters = parseCurriculum(curriculumPath);

function getCleanSpokenText(text) {
  if (!text) return "";
  let cleaned = text;
  const annotationRegex =
    /`?([\u4e00-\u9fff\u3400-\u4dbf\uf900-\ufaffA-Za-z0-9.-]+)\[([^\]\n|]+)\|([^\]\n]+)\]`?/g;
  cleaned = cleaned.replace(annotationRegex, (match, char) => char);
  cleaned = cleaned.replace(/\[[^\]]+\]/g, "");
  return cleaned.trim();
}

function getStablePhraseId(text) {
  const clean = text.replace(/`?([\u4e00-\u9fff\u3400-\u4dbf\uf900-\ufaffA-Za-z0-9.-]+)\[([^\]\n|]+)\|([^\]\n]+)\]`?/g, "$1")
                    .replace(/[^\u4e00-\u9fff\u3400-\u4dbf\uf900-\ufaffA-Za-z0-9]/g, '');
  let hash = 5381;
  for (let i = 0; i < clean.length; i++) {
    hash = (hash * 33) ^ clean.charCodeAt(i);
  }
  const hashStr = (hash >>> 0).toString(36);
  return `phr-${clean.length}-${hashStr}`;
}

// Load vocabulary.json database
const vocabPath = path.resolve("content/vocabulary.json");
const allVocabRaw = JSON.parse(await fsPromises.readFile(vocabPath, "utf8"));

// Compile chapter items mapping
const allChaptersData = [];
chapters.forEach((chapter, idx) => {
  const file = chapter.file;
  const filePath = path.resolve("content", file);
  const fileExists = fs.existsSync(filePath);
  
  const phraseIds = [];
  if (fileExists) {
    try {
      const { blocks } = parseChapter(filePath);
      for (const block of blocks) {
        if (block.type === "cantonese") {
          const parts = block.content.split("===");
          const cantoneseRaw = parts[0] ? parts[0].trim() : "";
          const english = parts[1] ? parts[1].trim() : "";
          if (cantoneseRaw && english) {
            phraseIds.push(getStablePhraseId(cantoneseRaw));
          }
        }
      }
    } catch (e) {
      console.error(`Failed to parse chapter ${chapter.id} for advanced page:`, e);
    }
  }

  // Filter vocabulary associated with this chapter
  const vocabIds = allVocabRaw
    .filter(item => item.firstIntroducedIn === chapter.id)
    .map(item => `vocab-${item.character}_${item.jyutping.replace(/\s+/g, "")}`);

  allChaptersData.push({
    id: chapter.id,
    title: chapter.title,
    number: idx,
    exists: fileExists,
    phrases: phraseIds,
    vocab: vocabIds
  });
});
---

<BaseLayout title="Advanced Settings" description="Developer settings to inspect and manually manage local storage course progress.">
  <div class="advanced-page">
    <div style="margin-bottom: 2rem;">
      <span style="font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-color);">
        廣東話 Developer
      </span>
      <h1 style="margin-top: 0.2rem; margin-bottom: 0.5rem;">Advanced Settings</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.4; font-style: italic; margin-bottom: 0;">
        Inspect and manually manage your client-side progress data and SRS learning state.
      </p>
    </div>

  <!-- Notification Toast -->
  <div id="toast" class="toast-notification" aria-live="polite"></div>

  <!-- Main Grid/Flex Container -->
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    
    <!-- SECTION 1: COMPLETED CHAPTERS -->
    <div class="advanced-card">
      <h2 class="section-title">Completed Chapters</h2>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.2rem;">
        Chapters you have marked as completed. Removing a chapter will mark it incomplete and delete all its phrasebook and vocabulary spaced repetition (SRS) records.
      </p>
      
      <div id="completed-chapters-list" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <!-- Dynamically Rendered by Client Script -->
        <div class="placeholder-msg">Loading completed chapters...</div>
      </div>
    </div>

    <!-- SECTION 2: DATA MAINTENANCE -->
    <div class="advanced-card">
      <h2 class="section-title">Data Maintenance</h2>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.2rem;">
        Perform utility checks and maintenance operations on your local progress storage.
      </p>
      
      <div style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
        <button id="clean-incomplete-btn" class="canto-btn secondary">
          Clean Incomplete Chapters' Data
        </button>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
          Removes phrasebook and vocabulary SRS learning records that belong to chapters you have not marked as completed.
        </p>
      </div>
    </div>

    <!-- SECTION 3: DANGER ZONE -->
    <div class="advanced-card danger-card">
      <h2 class="section-title" style="color: #c53030;">Danger Zone</h2>
      <p style="font-size: 0.95rem; color: #742a2a; margin-bottom: 1.2rem;">
        Once deleted, your progress is gone forever. This cannot be undone.
      </p>
      
      <div style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
        <button id="clear-all-btn" class="canto-btn danger">
          Clear All Progress Data
        </button>
        <p style="font-size: 0.85rem; color: #742a2a; margin: 0;">
          Clears completed chapters, phrasebook SRS state, and vocabulary SRS state. Resets all progress.
        </p>
      </div>
    </div>

  </div>

  <!-- Confirmation Modal -->
  <div id="confirm-modal" class="modal-overlay" aria-hidden="true" role="dialog">
    <div class="modal-content">
      <h3 style="margin-top: 0; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Confirm Reset</h3>
      <p id="confirm-message" style="font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.5; color: var(--text-color);">
        Are you sure you want to clear all progress? This will reset all completed chapters and SRS cards, and cannot be undone.
      </p>
      <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button id="modal-cancel-btn" class="canto-btn secondary">Cancel</button>
        <button id="modal-confirm-btn" class="canto-btn danger">Confirm Reset</button>
      </div>
    </div>
  </div>

    <script is:inline define:vars={{ allChaptersData }}>
    window.__allChaptersData = allChaptersData;
  </script>
  <script src="../client/advanced-settings.ts"></script>
  </div>
</BaseLayout>

