---
import fs from "fs";
import path from "path";
import { createRequire } from "module";
import BaseLayout from "../layouts/BaseLayout.astro";

// Load and execute scripts/lib/parser.js to get curriculum chapters
const cjsRequire = createRequire(import.meta.url);
const parserPath = path.resolve(process.cwd(), "scripts/lib/parser.js");
const parserCode = fs.readFileSync(parserPath, "utf8");

const parserModule = { exports: {} };
const runParser = new Function("exports", "require", "module", "__filename", "__dirname", parserCode);
runParser(
  parserModule.exports,
  cjsRequire,
  parserModule,
  parserPath,
  path.dirname(parserPath)
);

const { parseCurriculum, parseChapter } = parserModule.exports;
const curriculumPath = path.resolve("content/curriculum.md");
const chapters = parseCurriculum(curriculumPath);

// Prepare chapter entries with exist status and description
const chapterEntries = chapters.map(c => {
  const fileExists = fs.existsSync(path.resolve("content", c.file));
  let description = "";
  if (fileExists) {
    try {
      const chapterData = parseChapter(path.resolve("content", c.file));
      description = chapterData.frontmatter?.description || "";
    } catch (e) {
      console.error(`Failed to parse chapter description for ${c.file}:`, e);
    }
  }
  return {
    ...c,
    id: String(c.chapter).padStart(2, "0"),
    exists: fileExists,
    description: description.trim() || "Topic outline and learning materials coming soon."
  };
});
---

<BaseLayout title="Curriculum Index" description="Colloquial Cantonese course reader and living curriculum roadmap.">
  <div style="margin-bottom: 2rem;">
    <span style="font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-color);">
      廣東話 Course Reader
    </span>
    <h1 style="margin-top: 0.2rem; margin-bottom: 0.5rem;">Curriculum Index</h1>
    <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.4; font-style: italic; margin-bottom: 0;">
      A spiraled and integrated Cantonese learning curriculum. Select a chapter below to start reading.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    {chapterEntries.map((chapter) => (
      <div class="cantonese-example-card" data-chapter-card={chapter.chapter} style={`border-left-color: ${chapter.exists ? "var(--accent-color)" : "var(--border-color)"}; opacity: ${chapter.exists ? 1 : 0.6}; padding: 0.8rem 1rem; margin-bottom: 0;`}>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.2rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
              Chapter {chapter.chapter}
            </span>
          </div>
          {!chapter.exists && (
            <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); background: var(--border-color); padding: 0.1rem 0.4rem; border-radius: 3px;">
              Coming Soon
            </span>
          )}
        </div>
        
        {chapter.exists ? (
          <h3 style="margin: 0 0 0.4rem 0;">
            <a href={`/cantonese/chapter/${chapter.id}/`} style="color: var(--text-color); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s ease;" onmouseover="this.style.borderColor='var(--text-color)'" onmouseout="this.style.borderColor='transparent'">
              {chapter.title}
            </a>
          </h3>
        ) : (
          <h3 style="margin: 0 0 0.4rem 0; color: var(--text-muted);">
            {chapter.title}
          </h3>
        )}
        
        <p style="font-size: 0.95rem; color: var(--text-muted); margin: 0; line-height: 1.45;">
          {chapter.description || "No description available."}
        </p>
      </div>
    ))}
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let unlocked = [0]; // default is Chapter 0
      try {
        const stored = localStorage.getItem('cantonese_unlocked_chapters');
        if (stored) {
          unlocked = JSON.parse(stored).map(Number);
        }
      } catch (e) {
        console.error('Failed to parse unlocked chapters:', e);
      }
      
      const cards = document.querySelectorAll('[data-chapter-card]');
      cards.forEach(card => {
        const chNum = parseInt(card.getAttribute('data-chapter-card'), 10);
        if (unlocked.includes(chNum)) {
          card.style.borderLeftColor = 'var(--secondary-color)';
        }
      });
    });
  </script>
</BaseLayout>
