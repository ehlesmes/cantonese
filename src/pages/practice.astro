---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Practice" description="Practice and master Cantonese vocabulary and sentences using Spaced Repetition (SRS).">
  <div class="page-header" style="margin-bottom: 2rem;">
    <span class="page-subtitle" style="font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-color);">
      廣東話 Practice
    </span>
    <h1 class="page-title" style="margin-top: 0.2rem; margin-bottom: 0.5rem;">Spaced Repetition Practice</h1>
    <p class="page-desc" style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.4; font-style: italic; margin-bottom: 0;">
      Test your recall. Practice vocabulary flashcards and unscramble sentence structures.
    </p>
  </div>

  {/* MAIN CONTROLLER CONTAINER */}
  <div id="review-root">
    
    {/* DASHBOARD VIEW */}
    <div id="dashboard-view" class="review-dashboard">
      
      {/* Top Play Action (Easy Access) */}
      <div class="cantonese-example-card dashboard-hero" style="border-left-color: var(--accent-color); padding: 1.5rem; text-align: center; background-color: #faf7ef;">
        <h2 class="hero-title" style="margin-top: 0; margin-bottom: 0.5rem; border-bottom: none; padding-bottom: 0;">Ready to Practice?</h2>
        <p class="hero-desc" style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.2rem;">
          We will select 10 items (mixed vocabulary and phrases) using Spaced Repetition weights.
        </p>
        <button id="start-session-btn" class="hero-btn" style="font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: #ffffff; background-color: var(--accent-color); border: none; border-radius: 6px; padding: 0.75rem 2rem; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 6px rgba(179, 80, 26, 0.15);">
          Start Practice Session (10 Cards)
        </button>
      </div>

      {/* Stats Section */}
      <div class="srs-stats-grid">
        <div class="srs-stat-card">
          <div class="srs-stat-number" id="stats-chapters-count">0</div>
          <div class="srs-stat-label">Chapters Unlocked</div>
        </div>
        <div class="srs-stat-card">
          <div class="srs-stat-number" id="stats-cards-count">0</div>
          <div class="srs-stat-label">Total Items in Pool</div>
        </div>
        <div class="srs-stat-card">
          <div class="srs-stat-number" id="stats-mastered-count">0</div>
          <div class="srs-stat-label">Mastered (Lvl 5)</div>
        </div>
      </div>

      {/* Review Pool Items Directory (With Grouping Controls) */}
      <div class="directory-wrapper" style="margin-top: 1rem;">
        <div class="directory-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
          <div style="display: flex; gap: 1rem; align-items: baseline;">
            <h2 class="directory-title" style="margin: 0; border: none; padding: 0; font-size: 1.3rem;">Active Directory</h2>
            <div class="type-tabs" style="display: flex; gap: 0.5rem;">
              <button id="tab-vocab-btn" class="type-tab-btn active" style="background: none; border: none; font-size: 0.9rem; font-weight: 600; cursor: pointer; color: var(--accent-color); border-bottom: 2px solid var(--accent-color); padding: 0.2rem 0;">Vocabulary</button>
              <button id="tab-phrase-btn" class="type-tab-btn" style="background: none; border: none; font-size: 0.9rem; font-weight: 600; cursor: pointer; color: var(--text-muted); padding: 0.2rem 0;">Phrases</button>
            </div>
          </div>
          
          <div class="directory-actions" style="display: flex; gap: 0.5rem; align-items: center;">
            <div class="group-tabs" style="margin-bottom: 0;">
              <button id="group-by-chapter-btn" class="group-tab-btn active">By Chapter</button>
              <button id="group-by-level-btn" class="group-tab-btn">By SRS Level</button>
            </div>
            <button id="expand-collapse-all-btn" class="canto-btn secondary collapse-all-btn" style="padding: 0.35rem 0.8rem; font-size: 0.8rem; margin-bottom: 0; border-radius: 4px; font-family: var(--font-heading); font-weight: 600;">Collapse All</button>
          </div>
        </div>
        
        <div id="review-items-list-container">
          {/* Dynamic lists rendered via JavaScript */}
        </div>
      </div>

    </div>

    {/* SESSION VIEW */}
    <div id="session-view" class="session-view" style="display: none; flex-direction: column; gap: 1.5rem;">
      <div class="session-header" style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; color: var(--text-muted);">
        <span id="session-progress-text" class="session-progress" style="font-weight: 600;">Card 1 of 10</span>
        <button id="session-quit-btn" class="session-quit" style="background: none; border: none; color: var(--accent-color); font-weight: 600; cursor: pointer; font-size: 0.88rem;">Quit Session</button>
      </div>

      <div class="progress-bar-container">
        <div id="session-progress-fill" class="progress-bar-fill"></div>
      </div>

      {/* COMMON CARD LABEL */}
      <span id="session-chapter-label" class="session-label" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem; text-align: center; width: 100%;">Chapter 1</span>

      {/* --- VOCABULARY FLASHCARD UI --- */}
      <div id="vocab-ui-container" class="flashcard-card" style="display: none;">
        {/* Cantonese Character Prompt (with hover romanization & click TTS) */}
        <div id="flashcard-character-container" class="flashcard-character">
          {/* Populated dynamically */}
        </div>

        {/* Action Button: Reveal Answer */}
        <button id="flashcard-reveal-btn" class="flashcard-reveal-btn">
          Reveal Translation
        </button>

        {/* Revealed Section (Translation & Self Grading) */}
        <div id="flashcard-answer-section" class="flashcard-answer-section" style="display: none;">
          <div id="flashcard-translation-text" class="flashcard-translation">
            English Translation
          </div>

          <div style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.6rem; letter-spacing: 0.05em; text-align: center;">
            Did you remember it?
          </div>
          
          <div class="flashcard-grade-grid">
            <button id="grade-forgot-btn" class="btn-grade btn-grade-forgot">
              Forgot
            </button>
            <button id="grade-remembered-btn" class="btn-grade btn-grade-remembered">
              Remembered
            </button>
          </div>
        </div>
      </div>

      {/* --- PHRASEBOOK UNSCRAMBLE UI --- */}
      <div id="phrase-ui-container" class="cantonese-example-card session-card" style="border-left-color: var(--accent-color); padding: 1.5rem; background-color: #faf7ef; display: none;">
        {/* English Prompt */}
        <div id="session-english-prompt" class="session-prompt" style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 600; color: var(--text-color); line-height: 1.35; margin-bottom: 1.5rem;">
          English Translation Prompt
        </div>

        {/* Answer Slots Area */}
        <div class="session-section" style="margin-bottom: 1.2rem;">
          <div class="session-section-title" style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--accent-color); margin-bottom: 0.4rem; letter-spacing: 0.05em;">Assembled Translation:</div>
          <div id="game-answer-slots" class="answer-slots">
            {/* Clicked tokens will appear here */}
          </div>
        </div>

        {/* Scrambled Chips Area */}
        <div class="session-section" style="margin-bottom: 1.5rem;">
          <div class="session-section-title is-muted" style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem; letter-spacing: 0.05em;">Scrambled Tokens Pool:</div>
          <div id="game-tokens-pool" class="tokens-pool">
            {/* Scrambled chips go here */}
          </div>
        </div>

        {/* Buttons Panel */}
        <div class="session-actions" style="display: flex; gap: 0.75rem; align-items: center; justify-content: flex-end;">
          <button id="game-reset-btn" class="session-reset-btn" style="font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; border: 1px solid var(--border-color); background-color: transparent; border-radius: 4px; padding: 0.5rem 1rem; cursor: pointer; color: var(--text-muted); transition: all 0.2s ease;">Reset</button>
          <button id="game-check-btn" class="session-check-btn" style="font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: none; background-color: var(--accent-color); color: #ffffff; border-radius: 4px; padding: 0.55rem 1.5rem; cursor: pointer; transition: all 0.2s ease;">Check Answer</button>
        </div>
      </div>

      {/* FEEDBACK OVERLAY (SUCCESS / ERROR) for Phrasebook */}
      <div id="feedback-panel" style="display: none;">
        {/* Dynamic block matching either alert-note or alert-tip */}
      </div>

    </div>

    {/* SUMMARY VIEW */}
    <div id="summary-view" class="summary-view" style="display: none; flex-direction: column; gap: 1.5rem; text-align: center;">
      <div class="cantonese-example-card summary-card" style="border-left-color: var(--secondary-color); padding: 2.5rem 2rem; background-color: #faf7ef;">
        <span class="summary-icon" style="font-size: 2rem; display: block; margin-bottom: 0.5rem;">🎉</span>
        <h2 class="summary-title" style="margin-top: 0; border: none; padding-bottom: 0;">Session Completed!</h2>
        <div id="summary-score" class="summary-score" style="font-size: 2.5rem; font-family: var(--font-heading); font-weight: 700; color: var(--secondary-color); margin: 1rem 0;">
          8 / 10
        </div>
        <p id="summary-message" class="summary-message" style="font-size: 1.05rem; color: var(--text-muted); margin-bottom: 1.5rem;">
          Great job! Keep practicing to lock these vocabulary and phrases into long-term memory.
        </p>

        <div class="summary-actions" style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
          <button id="summary-dashboard-btn" class="summary-btn outline" style="font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; border: 1px solid var(--border-color); background-color: transparent; border-radius: 4px; padding: 0.6rem 1.5rem; cursor: pointer; color: var(--text-color);">
            Practice Dashboard
          </button>
          <button id="summary-retry-btn" class="summary-btn primary" style="font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: none; background-color: var(--accent-color); color: #ffffff; border-radius: 4px; padding: 0.6rem 1.5rem; cursor: pointer; transition: all 0.2s ease;">
            Practice Again
          </button>
        </div>
      </div>
    </div>

  </div>

  <script>
    import "../client/practice-ui.ts";
  </script>
</BaseLayout>

<style is:global>
  /* Collapsible Directory Accordions */
  .directory-wrapper .directory-section {
    margin-bottom: 0.75rem;
    border-radius: 6px;
    overflow: hidden;
  }

  .directory-wrapper .directory-group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 0.6rem 0.8rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    user-select: none;
    transition: background-color 0.15s ease;
    margin-bottom: 0.5rem;
  }

  .directory-wrapper .directory-group-header:hover {
    background-color: var(--border-color);
  }

  .directory-wrapper .header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .directory-wrapper .chevron-icon {
    transition: transform 0.2s ease;
    transform: rotate(90deg);
    color: var(--text-muted);
  }

  .directory-wrapper .group-title {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-color);
    font-size: 1.05rem;
  }

  .directory-wrapper .item-count-badge {
    background-color: var(--border-color);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.1rem 0.4rem;
    border-radius: 12px;
    font-weight: 500;
  }

  .directory-wrapper .small-btn {
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 4px;
    height: auto;
    line-height: 1;
    background-color: var(--accent-color);
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background-color 0.15s ease;
  }

  .directory-wrapper .small-btn:hover {
    background-color: var(--accent-hover);
  }

  .directory-wrapper .directory-group-content {
    padding: 0.8rem;
    border: 1px solid var(--border-color);
    border-top: none;
    border-radius: 0 0 6px 6px;
    margin-bottom: 0.75rem;
    background-color: var(--card-bg);
  }

  .directory-wrapper .directory-section.collapsed .chevron-icon {
    transform: rotate(0deg);
  }

  .directory-wrapper .directory-section.collapsed .directory-group-content {
    display: none;
  }
</style>
