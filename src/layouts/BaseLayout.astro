---
import "../styles/global.css";
import SyncModal from "../components/SyncModal.astro";
import fs from "node:fs";
import path from "node:path";

const { title, description = "Colloquial Cantonese course" } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/cantonese" || pathname === "/cantonese/";
const isPractice = pathname.startsWith("/cantonese/practice");

// Read version at build time
let buildVersion = "development";
try {
  const versionFile = path.resolve("public/version.json");
  if (fs.existsSync(versionFile)) {
    const data = JSON.parse(fs.readFileSync(versionFile, "utf-8"));
    buildVersion = data.version;
  }
} catch (e) {
  // Graceful fallback during dev or build errors
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Colloquial Cantonese</title>
    <meta name="description" content={description} />
    <meta name="app-version" content={buildVersion} />
  </head>
  <body>
    <header class="container site-header">
      <div class="site-header-inner">
        <span class="site-title">廣東話 Colloquial Cantonese</span>
        <div class="site-nav">
          <a href="/cantonese/" class:list={["nav-link", { active: isHome }]}>Home</a>
          <span class="nav-separator">|</span>
          <a href="/cantonese/practice/" class:list={["nav-link", { active: isPractice }]}>Practice</a>
          <span class="nav-separator">|</span>
          <button id="sync-trigger-btn" class="nav-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            Sync
          </button>
          <a href="#" id="update-indicator" class="update-indicator">
            <span class="update-dot"></span>
            Update Available
          </a>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <p>Colloquial Cantonese Course Reader &copy; {new Date().getFullYear()}</p>
    </footer>

    <SyncModal />

    <script src="../client/app-core.ts"></script>
    <style>
      .site-header { border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem; }
      .site-header-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
      .site-title { font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: var(--accent-color); }
      .site-nav { display: flex; gap: 1rem; align-items: center; }
      .nav-link { font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; color: var(--text-muted); text-decoration: none; transition: color 0.15s ease; }
      .nav-link:hover { color: var(--accent-hover); }
      .nav-link.active { color: var(--accent-color); }
      .nav-separator { color: var(--border-color); font-size: 0.8rem; }
      .nav-btn { font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; color: var(--text-muted); background: none; border: none; padding: 0; cursor: pointer; transition: color 0.15s ease; display: inline-flex; align-items: center; gap: 0.25rem; }
      .nav-btn:hover { color: var(--accent-hover); }
      .btn-icon { vertical-align: middle; }
      .update-indicator { font-family: var(--font-heading); font-weight: 600; font-size: 0.85rem; color: var(--accent-color); text-decoration: none; display: none; align-items: center; gap: 0.35rem; background: rgba(179, 80, 26, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px; transition: background-color 0.15s ease; }
      .update-indicator:hover { background-color: rgba(179, 80, 26, 0.15); }
      .update-dot { display: inline-block; width: 6px; height: 6px; background-color: var(--accent-color); border-radius: 50%; }
      .site-footer { margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 0.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted); }
    </style>
  </body>
</html>
