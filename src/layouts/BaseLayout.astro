---
import "../styles/global.css";

const { title, description = "Colloquial Cantonese course" } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/cantonese" || pathname === "/cantonese/";
const isPhrasebook = pathname.startsWith("/cantonese/phrasebook");
const isVocabulary = pathname.startsWith("/cantonese/vocabulary");

const getLinkStyle = (isActive) => {
  return `font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; color: ${isActive ? "var(--accent-color)" : "var(--text-muted)"}; text-decoration: none; transition: color 0.15s ease;`;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Colloquial Cantonese</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="container" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <span style="font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: var(--accent-color);">廣東話 Colloquial Cantonese</span>
        <div style="display: flex; gap: 1rem; align-items: center;">
          <a href="/cantonese/" style={getLinkStyle(isHome)} onmouseover="this.style.color='var(--accent-hover)'" onmouseout={`this.style.color='${isHome ? "var(--accent-color)" : "var(--text-muted)"}'`}>Home</a>
          <span style="color: var(--border-color); font-size: 0.8rem;">|</span>
          <a href="/cantonese/phrasebook/" style={getLinkStyle(isPhrasebook)} onmouseover="this.style.color='var(--accent-hover)'" onmouseout={`this.style.color='${isPhrasebook ? "var(--accent-color)" : "var(--text-muted)"}'`}>Phrasebook</a>
          <span style="color: var(--border-color); font-size: 0.8rem;">|</span>
          <a href="/cantonese/vocabulary/" style={getLinkStyle(isVocabulary)} onmouseover="this.style.color='var(--accent-hover)'" onmouseout={`this.style.color='${isVocabulary ? "var(--accent-color)" : "var(--text-muted)"}'`}>Vocabulary</a>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container" style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 0.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      <p>Colloquial Cantonese Course Reader &copy; {new Date().getFullYear()}</p>
    </footer>

    <script>
      // Native Cantonese TTS Engine
      let cantoVoice = null;
      let activeUtterance = null;
      let activeBtn = null;

      function loadVoices() {
        if (!window.speechSynthesis) return;
        const voices = window.speechSynthesis.getVoices();
        
        // Find all Cantonese voices
        const hkVoices = voices.filter(v => {
          const lang = v.lang.toLowerCase();
          return lang === 'zh-hk' || lang === 'zh-yue' || lang.replace('_', '-') === 'zh-hk';
        });

        if (hkVoices.length > 0) {
          // Prioritize Siri (best prosody), Premium (high quality), and Enhanced (high quality accessibility)
          cantoVoice = hkVoices.find(v => v.name.toLowerCase().includes('siri')) ||
                       hkVoices.find(v => v.name.toLowerCase().includes('premium')) ||
                       hkVoices.find(v => v.name.toLowerCase().includes('enhanced')) ||
                       hkVoices[0];
          
          console.log('Selected Cantonese Voice:', cantoVoice.name, '(', cantoVoice.lang, ')');
        } else {
          cantoVoice = null;
        }
      }

      if (window.speechSynthesis) {
        window.speechSynthesis.onvoiceschanged = loadVoices;
        loadVoices();
      }

      function getCleanCantoneseText(element) {
        const clone = element.cloneNode(true);
        clone.querySelectorAll('.tooltip-popover').forEach(el => el.remove());
        return clone.textContent.trim();
      }

      function speakText(text, onEndCallback) {
        if (!window.speechSynthesis) return;

        // Cancel active speech and clean up active button style
        window.speechSynthesis.cancel();
        if (activeBtn) {
          activeBtn.classList.remove('tts-playing');
          activeBtn = null;
        }

        const utterance = new SpeechSynthesisUtterance(text);
        if (cantoVoice) {
          utterance.voice = cantoVoice;
        } else {
          utterance.lang = 'zh-HK';
        }

        // Set rate slightly slower (0.85) to make pronunciation and tones clearer for learners
        utterance.rate = 0.85;

        utterance.onend = () => {
          if (onEndCallback) onEndCallback();
        };
        utterance.onerror = () => {
          if (onEndCallback) onEndCallback();
        };

        activeUtterance = utterance;
        window.speechSynthesis.speak(utterance);
      }

      // Event delegation for TTS clicks
      document.addEventListener('DOMContentLoaded', () => {
        // Keep tooltips within viewport boundaries
        function adjustTooltipPosition(vocabTerm) {
          const popover = vocabTerm.querySelector('.tooltip-popover');
          if (!popover) return;

          // Reset positioning to get natural layout dimensions
          popover.style.left = '';
          popover.style.removeProperty('--arrow-offset');

          const rect = popover.getBoundingClientRect();
          const viewportWidth = window.innerWidth;
          const padding = 12; // safe boundary from screen edges

          const overflowLeft = padding - rect.left;
          const overflowRight = rect.right - (viewportWidth - padding);

          if (overflowLeft > 0) {
            // Shift right to avoid left edge clipping
            popover.style.left = `calc(50% + ${overflowLeft}px)`;
            popover.style.setProperty('--arrow-offset', `calc(50% - ${overflowLeft}px)`);
          } else if (overflowRight > 0) {
            // Shift left to avoid right edge clipping
            popover.style.left = `calc(50% - ${overflowRight}px)`;
            popover.style.setProperty('--arrow-offset', `calc(50% + ${overflowRight}px)`);
          }
        }

        // Adjust position on hover (mouseover) or touchstart/click
        const handleTooltipEvent = (e) => {
          const vocabTerm = e.target.closest('.vocab-term');
          if (vocabTerm) {
            adjustTooltipPosition(vocabTerm);
          }
        };

        document.body.addEventListener('mouseover', handleTooltipEvent, { passive: true });
        document.body.addEventListener('touchstart', handleTooltipEvent, { passive: true });
        document.body.addEventListener('click', handleTooltipEvent, { passive: true });

        // Handle Vocab Term Clicks
        document.body.addEventListener('click', (e) => {
          const vocabTerm = e.target.closest('.vocab-term');
          if (vocabTerm) {
            e.stopPropagation();
            
            const text = getCleanCantoneseText(vocabTerm);
            
            // Highlight vocab term
            vocabTerm.classList.add('tts-playing');
            speakText(text, () => {
              vocabTerm.classList.remove('tts-playing');
            });
            
            // Backup removal in case onend doesn't trigger
            setTimeout(() => {
              vocabTerm.classList.remove('tts-playing');
            }, 1200);
          }
        });

        // Handle Play Button Clicks
        document.body.addEventListener('click', (e) => {
          const ttsBtn = e.target.closest('.tts-btn');
          if (ttsBtn) {
            e.stopPropagation();
            
            // Find target text container (either Cantonese sentence or dialogue line)
            const exampleCard = ttsBtn.closest('.cantonese-example-card');
            const dialogueTurn = ttsBtn.closest('.dialogue-turn');
            
            let targetEl = null;
            if (exampleCard) {
              targetEl = exampleCard.querySelector('.cantonese-sentence');
            } else if (dialogueTurn) {
              targetEl = dialogueTurn.querySelector('.dialogue-cantonese');
            }
            
            if (targetEl) {
              const text = getCleanCantoneseText(targetEl);
              
              ttsBtn.classList.add('tts-playing');
              activeBtn = ttsBtn;
              
              speakText(text, () => {
                ttsBtn.classList.remove('tts-playing');
                if (activeBtn === ttsBtn) activeBtn = null;
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
