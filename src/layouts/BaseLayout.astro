---
import "../styles/global.css";

const { title, description = "Colloquial Cantonese course" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Colloquial Cantonese</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="container" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: var(--accent-color);">廣東話 Colloquial Cantonese</span>
        <span style="font-size: 0.9rem; color: var(--text-muted); font-style: italic;">Phase 1 Reader</span>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container" style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 0.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      <p>Colloquial Cantonese Course Reader &copy; {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>
