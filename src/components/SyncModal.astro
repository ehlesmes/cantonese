---
// SyncModal.astro - Progress Synchronization Modal
import "../styles/sync-modal.css";
---
<div id="sync-modal-overlay" class="sync-modal-overlay" aria-hidden="true">
  <div class="sync-modal-card">
    <button id="sync-modal-close" class="sync-modal-close-btn" aria-label="Close sync modal">&times;</button>
    
    <h2 id="sync-modal-title" style="margin-top: 0.2rem; margin-bottom: 1rem; border-bottom: none; font-size: 1.5rem;">Sync Progress</h2>
    
    {/* TAB NAVIGATION */}
    <div id="sync-tabs-nav" class="sync-tabs" role="tablist" aria-label="Synchronization Options" style="margin-bottom: 0.75rem;">
      <button id="tab-show-btn" class="sync-tab-btn active" role="tab" aria-selected="true" aria-controls="sync-tab-show-content">Show QR Code</button>
      <button id="tab-scan-btn" class="sync-tab-btn" role="tab" aria-selected="false" aria-controls="sync-tab-scan-content">Scan QR Code</button>
    </div>

    {/* SINGLE SYNC VIEW */}
    <div id="sync-main-view" style="display: flex; flex-direction: column; gap: 0.75rem;">
      
      {/* SHOW QR TAB CONTENT */}
      <div id="sync-tab-show-content" class="sync-tab-content active" role="tabpanel" aria-labelledby="tab-show-btn" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; margin: 0; text-align: center;">
          On your other device, select <strong>"Scan QR Code"</strong> and scan this code.
        </p>
        
        {/* QR CONTAINER */}
        <div id="sync-qr-wrapper" class="qr-container" style="display: none; min-height: 200px;">
          <canvas id="sync-qr-canvas"></canvas>
          <div id="qr-loading-text" class="qr-placeholder">Generating connection QR...</div>
        </div>
      </div>

      {/* SCAN QR TAB CONTENT */}
      <div id="sync-tab-scan-content" class="sync-tab-content" role="tabpanel" aria-labelledby="tab-scan-btn" style="display: none; flex-direction: column; gap: 0.75rem;">
        <p id="scan-instructions" style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; margin: 0; text-align: center;">
          Scan the QR code displayed on your other device.
        </p>
        
        {/* SCANNER PREVIEW BOX */}
        <div id="scanner-section" class="scanner-container">
          <div id="scanner-preview-wrapper" class="scanner-preview-wrapper" style="width: 100%; margin-bottom: 0;">
            <video id="sync-video" playsinline></video>
            <div class="scanner-overlay-laser"></div>
            <canvas id="sync-hidden-canvas" style="display: none;"></canvas>
          </div>
          <div id="scanner-status" class="scanner-status-text" style="margin-top: 0.5rem; margin-bottom: 0;">Accessing camera...</div>
        </div>

        {/* ANSWER QR CODE CONTAINER (Shown on Device B once it scans offer) */}
        <div id="answer-qr-section" style="display: none; flex-direction: column; gap: 0.75rem; align-items: center;">
          <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; margin: 0; text-align: center;">
            On your other device, select <strong>"Scan QR Code"</strong> and scan this code.
          </p>
          <div class="qr-container" style="min-height: 200px; width: 100%;">
            <canvas id="answer-qr-canvas"></canvas>
            <div id="answer-qr-loading-text" class="qr-placeholder">Generating Answer QR...</div>
          </div>
        </div>
      </div>

      {/* CENTERED STATUS TEXT LABEL */}
      <div id="sync-status-text" style="text-align: center; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); margin-top: 0.25rem;">Preparing WebRTC connection...</div>

      {/* ACTION BUTTONS */}
      <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.25rem;">
        <button id="sync-reset-btn" class="sync-action-btn secondary" style="width: 100%; display: none;">Reset Connection</button>
      </div>

      {/* OFFLINE FALLBACK LINK */}
      <div id="sync-offline-link-container" style="text-align: center; margin-top: 0.25rem;">
        <button id="sync-offline-toggle-btn" style="background: none; border: none; color: var(--accent-color); font-size: 0.8rem; cursor: pointer; text-decoration: underline; padding: 0.25rem;">Use offline copy-paste fallback</button>
      </div>
    </div>

    {/* OFFLINE FALLBACK VIEW */}
    <div id="sync-offline-view" style="display: none; flex-direction: column; gap: 1rem; margin-top: 0.5rem; border-top: 1px dashed var(--border-color); padding-top: 1rem;">
      <h3 style="margin: 0; font-size: 1rem; color: var(--text-color);">Offline Fallback</h3>
      
      <div class="sync-field-group">
        <label for="sync-export-string" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.25rem;">Copy Your Progress Code</label>
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="sync-export-string" readonly style="flex: 1; border: 1px solid var(--border-color); border-radius: 6px; padding: 0.5rem; font-family: monospace; font-size: 0.8rem; background: var(--bg-color); color: var(--text-color);" />
          <button id="sync-copy-btn" class="sync-action-btn accent">Copy</button>
        </div>
      </div>

      <div class="sync-field-group">
        <label for="sync-import-string" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.25rem;">Or Paste Progress Code</label>
        <textarea id="sync-import-string" placeholder="Paste progress code here..." style="width: 100%; height: 60px; border: 1px solid var(--border-color); border-radius: 6px; padding: 0.5rem; font-family: monospace; font-size: 0.8rem; background: var(--bg-color); color: var(--text-color); resize: none; margin-bottom: 0.5rem;"></textarea>
        <button id="sync-import-submit-btn" class="sync-action-btn accent" style="width: 100%;">Import Progress</button>
      </div>

      <div id="sync-offline-error" style="color: #ff3b30; font-size: 0.82rem; text-align: center; display: none; margin-top: -0.25rem;"></div>

      <div style="text-align: center;">
        <button id="sync-offline-close-btn" style="background: none; border: none; color: var(--accent-color); font-size: 0.8rem; cursor: pointer; text-decoration: underline;">Return to WebRTC Sync</button>
      </div>
    </div>

    {/* CONFIRMATION SECTION (DYNAMICALY SHOWS ON MERGE IMPORT) */}
    <div id="sync-confirm-view" class="sync-confirm-view" style="display: none;">
      <h3 style="margin-top: 0; color: var(--accent-color); font-size: 1.3rem;">Import Progress?</h3>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.2rem;">
        We found progress from another device. Here is what will change if you merge it:
      </p>

      <div class="compare-stats-box">
        <div class="compare-row header">
          <span>Metric</span>
          <span>Current</span>
          <span>&rarr; After Merge</span>
        </div>
        <div class="compare-row">
          <span>Unlocked Chapters</span>
          <span id="confirm-chapters-local">0</span>
          <span id="confirm-chapters-merged" class="stat-highlight">0</span>
        </div>
        <div class="compare-row">
          <span>Phrasebook Reviews</span>
          <span id="confirm-srs-local">0</span>
          <span id="confirm-srs-merged" class="stat-highlight">0</span>
        </div>
        <div class="compare-row">
          <span>Vocabulary Reviews</span>
          <span id="confirm-vocab-local">0</span>
          <span id="confirm-vocab-merged" class="stat-highlight">0</span>
        </div>
      </div>

      <div id="confirm-status-text" style="text-align: center; font-size: 0.85rem; font-weight: 600; margin-top: 1rem; display: none;"></div>

      <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
        <button id="sync-confirm-no" class="sync-action-btn secondary" style="flex: 1;">Cancel</button>
        <button id="sync-confirm-yes" class="sync-action-btn accent" style="flex: 1;">Merge and Reload</button>
      </div>
    </div>
  </div>
</div>

<script src="../client/sync-ui.js"></script>
