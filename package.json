{
  "name": "cantonese-course",
  "version": "1.0.0",
  "description": "Colloquial Cantonese course content validator and vocabulary database tracker.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:coverage": "rm -rf .nyc_output coverage-e2e && COVERAGE=true playwright test && npx nyc report --temp-dir .nyc_output --reporter text --reporter html --report-dir coverage-e2e",
    "validate": "tsx scripts/validate-format.ts && tsx scripts/validate-portability.ts",
    "validate:portability": "tsx scripts/validate-portability.ts",
    "track": "tsx scripts/track-vocabulary.ts",
    "lint": "eslint .",
    "vocab:register": "tsx scripts/register-word.ts",
    "vocab:register-missing": "tsx scripts/register-missing.ts",
    "vocab:verify": "tsx scripts/verify-chapter-vocab.ts",
    "vocab:verify-all": "tsx scripts/verify-chapter-vocab.ts",
    "vocab:lookup": "tsx scripts/lookup.ts",
    "vocab:build-ref": "tsx scripts/build-reference-list.ts",
    "vocab:eval": "tsx scripts/evaluate-coverage.ts",
    "dev": "astro dev",
    "tts:generate": "tsx scripts/generate-tts.ts",
    "build": "npm run typecheck && tsx scripts/generate-version.ts && tsx scripts/generate-tts.ts && npm run vocab:verify-all && npm run validate && astro build --force",
    "preview": "astro preview",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "typecheck": "tsc --noEmit",
    "type-coverage": "type-coverage --detail --at-least 100"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.3.0",
    "@playwright/test": "^1.61.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.3.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "tsx": "^4.23.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-coverage-report": "^1.1.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.7"
  },
  "private": true,
  "dependencies": {
    "astro": "^6.4.7",
    "jsqr": "^1.4.0",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4"
  }
}
