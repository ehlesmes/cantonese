{
  "name": "cantonese-course",
  "version": "1.0.0",
  "description": "Colloquial Cantonese course content validator and vocabulary database tracker.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-format.js && node scripts/validate-portability.js",
    "validate:portability": "node scripts/validate-portability.js",
    "track": "node scripts/track-vocabulary.js",
    "lint": "eslint .",
    "vocab:register": "node scripts/register-word.js",
    "vocab:register-missing": "node scripts/register-missing.js",
    "vocab:verify": "node scripts/verify-chapter-vocab.js",
    "vocab:verify-all": "node scripts/verify-chapter-vocab.js",
    "vocab:lookup": "node scripts/lookup.js",
    "vocab:build-ref": "node scripts/build-reference-list.js",
    "vocab:eval": "node scripts/evaluate-coverage.js",
    "dev": "astro dev",
    "tts:generate": "node scripts/generate-tts.js",
    "build": "node scripts/generate-version.js && node scripts/generate-tts.js && npm run vocab:verify-all && npm run validate && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@playwright/test": "^1.61.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.3.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  },
  "private": true,
  "dependencies": {
    "astro": "^6.4.7",
    "jsqr": "^1.4.0",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4"
  }
}
