{
  "name": "cantonese-course",
  "version": "1.0.0",
  "description": "Colloquial Cantonese course content validator and vocabulary database tracker.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-format.js && node scripts/validate-portability.js",
    "validate:portability": "node scripts/validate-portability.js",
    "track": "node scripts/track-vocabulary.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^9.3.0",
    "vitest": "^4.1.7"
  },
  "private": true
}
